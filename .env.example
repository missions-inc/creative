# =========================================================================
# Firebase 設定値のテンプレート
# -------------------------------------------------------------------------
# このファイルをコピーして `.env.local` を作成し、実際の値を入れてください。
#   cp .env.example .env.local
#
# NEXT_PUBLIC_ で始まる変数はブラウザに公開されます（Firebase の Web 設定値は
# 公開前提の値なので問題ありません。アクセス制御はセキュリティルールで担保します）。
# サーバー専用のシークレット（サービスアカウント）は NEXT_PUBLIC_ を付けないこと。
# =========================================================================

# --- Firebase Web App 設定（Firebase コンソール > プロジェクトの設定 > 全般）---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- FCM Web Push（Firebase コンソール > Cloud Messaging > ウェブ構成 > 鍵ペア）---
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# --- 許可ドメイン / 初期管理者（仕様で確定済みのため既定値を記載）---
NEXT_PUBLIC_ALLOWED_EMAIL_DOMAIN=missions.co.jp
NEXT_PUBLIC_BOOTSTRAP_ADMIN_EMAIL=s.matsumoto@missions.co.jp

# --- ローカル開発でエミュレータに接続する場合は true（本番は未設定 or false）---
NEXT_PUBLIC_USE_FIREBASE_EMULATORS=false

# =========================================================================
# サーバー側（Firebase Admin SDK / Cloud Functions）専用のシークレット
# -------------------------------------------------------------------------
# 本番の Cloud Functions では Application Default Credentials を使うため通常は不要。
# ローカルで Admin SDK を使う場合のみ、サービスアカウント鍵の JSON パスを指定。
# （serviceAccountKey.json は .gitignore 済み。絶対にコミットしないこと）
# =========================================================================
GOOGLE_APPLICATION_CREDENTIALS=
FIREBASE_ADMIN_PROJECT_ID=
