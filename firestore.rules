rules_version = '2';

// =============================================================================
// Phase 0 プレースホルダ
// -----------------------------------------------------------------------------
// 既定は「全拒否」。実際のロール別・公開範囲別ルールは Phase 2 で実装する。
// （セーフデフォルト：ルール未整備の状態で誤ってデータが露出しないようにする）
// =============================================================================
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
