{
  "name": "task-management-app",
  "version": "0.1.0",
  "private": true,
  "description": "クライアント別・プロジェクト別のタスク管理アプリ (Next.js + Firebase)",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "emulators": "firebase emulators:start --only auth,firestore,storage",
    "test:rules": "firebase emulators:exec --only firestore,storage \"vitest run\"",
    "test:rules:watch": "firebase emulators:exec --only firestore,storage \"vitest\""
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "firebase": "^12.0.0",
    "lucide-react": "^0.469.0",
    "next": "^15.5.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.5.0",
    "firebase-admin": "^13.0.0",
    "firebase-tools": "^13.29.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.0",
    "vitest": "^2.1.8"
  },
  "packageManager": "pnpm@11.25.0"
}
